<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        background-color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        margin: 0;
        padding: 0;
        color: #000000;
      }
      .container {
        max-width: 576px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      .heading {
        font-size: 1.5rem;
        font-weight: bold;
        color: #000000;
        margin: 2rem 0;
      }
      .text {
        color: #000000;
        font-size: 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
      }
      .card {
        background-color: #f5f5f5;
        border-radius: 0.5rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #ebebeb;
      }
      .card-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #000000;
        margin-bottom: 1rem;
      }
      .card-text {
        color: #000000;
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
      }
      .label {
        font-weight: 500;
      }
      .small-text {
        color: #262626;
        font-size: 0.75rem;
        margin-top: 0.5rem;
      }
      .italic {
        font-style: italic;
      }
      .button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        background-color: #0d0d0d;
        color: #ffffff !important;
        font-weight: bold;
        padding: 0.75rem 1.5rem;
        border-radius: 0.25rem;
        text-decoration: none;
        text-align: center;
        margin: 1rem 0;
      }
      .footer {
        background-color: #f5f5f5;
        border-top: 1px solid #ebebeb;
        border-radius: 0.5rem;
        color: #000000;
        font-size: 0.75rem;
        line-height: 1.75;
        padding: 1rem 1.5rem;
        margin-top: 2rem;
      }
      }
      .logo {
        height: 4rem;
        width: 4rem;
        margin-bottom: 0.5rem;
      }
      .muted {
        color: #262626;
      }
      .warning-box {
        background-color: #ffce69;
        border-left: 4px solid #ecae30;
        border-radius: 0.25rem;
        padding: 1rem;
        margin: 1.5rem 0;
      }
      .warning-text {
        color: #996600;
        font-size: 0.875rem;
        font-weight: 500;
        margin: 0;
      }
      .error-box {
        background-color: #ff9282;
        border-left: 4px solid e8594c;
        border-radius: 0.25rem;
        padding: 1rem;
        margin: 1.5rem 0;
      }
      .error-text {
        color: #9e0005;
        font-size: 0.875rem;
        font-weight: 500;
        margin: 0;
      }
      a {
        color: #0d0d0d;
        text-decoration: underline;
      }
    </style>
  </head>
  <body>
    <div class="container">
      {@inner_content}
    </div>
  </body>
</html>
