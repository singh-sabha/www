<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style>
      body {
        background-color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
        margin: 0;
        padding: 0;
      }
      .container {
        max-width: 576px;
        margin: 2rem auto;
        padding: 0 1rem;
      }
      .heading {
        font-size: 1.5rem;
        font-weight: bold;
        color: #1f2937;
        margin: 2rem 0;
      }
      .text {
        color: #374151;
        font-size: 1rem;
        margin-bottom: 1.5rem;
        line-height: 1.5;
      }
      .card {
        background-color: #f3f4f6;
        border-radius: 0.375rem;
        padding: 1.5rem;
        margin-bottom: 1.5rem;
        border: 1px solid #e5e7eb;
      }
      .card-title {
        font-size: 1.125rem;
        font-weight: 600;
        color: #1f2937;
        margin-bottom: 1rem;
      }
      .card-text {
        color: #374151;
        font-size: 0.875rem;
        margin-bottom: 0.5rem;
      }
      .label {
        font-weight: 500;
      }
      .small-text {
        color: #6b7280;
        font-size: 0.75rem;
        margin-top: 0.5rem;
      }
      .italic {
        font-style: italic;
      }
      .button {
        display: block;
        width: 100%;
        box-sizing: border-box;
        background-color: #2563eb;
        color: white !important;
        font-weight: bold;
        padding: 0.75rem 1.5rem;
        border-radius: 0.375rem;
        text-decoration: none;
        text-align: center;
        margin: 1rem 0;
      }
      .footer {
        color: #6b7280;
        font-size: 0.75rem;
        line-height: 1.75;
      }
      .logo {
        height: 4rem;
        width: 4rem;
        margin-bottom: 0.5rem;
      }
      a {
        color: #2563eb;
        text-decoration: underline;
      }
    </style>
  </head>

  <body>
    <div class="container">
      {@inner_content}
    </div>
  </body>
</html>
