<h1 class="heading">Update Email Instructions</h1>

<p class="text">
  Hi {@user.email},
</p>

<p class="text">
  You've requested to change your email address. Click the button below to proceed with updating your email.
</p>

<a href={@url} class="button">
  Update Email Address
</a>

<div class="card">
  <p class="card-title">Alternative Method</p>
  <p class="card-text">
    If the button above doesn't work, copy and paste this link into your browser:
  </p>
  <p class="card-text" style="word-break: break-all;">
    {@url}
  </p>
</div>

<p class="text italic" style="color: #6b7280; font-size: 0.875rem;">
  If you didn't request this change, please ignore this email. Your email address will not be changed.
</p>

<div class="footer">
  <img
    src="https://singhsabha.net/assets/singhsabha-logo.png"
    alt="Singh Sabha Logo"
    class="logo"
  />
  <p>
    <a href="https://singhsabha.net/" target="_blank">SinghSabha.net</a>, serving the Sikh community with devotion and compassion.
  </p>
</div>
