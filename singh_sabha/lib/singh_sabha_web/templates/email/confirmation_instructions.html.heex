<h1 class="heading">Welcome to Singh Sabha!</h1>

<p class="text">
  Hi {@user.email},
</p>

<p class="text">
  Thank you for creating an account with us. To get started, please confirm your email address by clicking the button below.
</p>

<a href={@url} class="button">
  Confirm Email Address
</a>

<div class="card">
  <p class="card-title">Alternative Method</p>
  <p class="card-text">
    If the button above doesn't work, copy and paste this link into your browser:
  </p>
  <p class="card-text" style="word-break: break-all;">
    {@url}
  </p>
</div>

<p class="text italic" style="color: #6b7280; font-size: 0.875rem;">
  If you didn't create an account with us, please ignore this email.
</p>

<div class="footer">
  <img
    src="https://singhsabha.net/images/logo.png"
    alt="Singh Sabha Logo"
    class="logo"
  />
  <p>
    <a href="https://singhsabha.net/" target="_blank">SinghSabha.net</a>, serving the Sikh community with devotion and compassion.
  </p>
</div>
